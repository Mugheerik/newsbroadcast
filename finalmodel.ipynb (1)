.\n","To authenticate with the Hugging Face Hub, create a token in your settings tab (https://huggingface.co/settings/tokens), set it as secret in your Google Colab and restart your session.\n","You will be able to reuse this secret in all of your notebooks.\n","Please note that authentication is recommended but still optional to access public models or datasets.\n","  warnings.warn(\n","Device set to use cuda:0\n"]}],"source":["import os\n","import cv2\n","import torch\n","import subprocess\n","import requests\n","import youtube_dl\n","import numpy as np\n","import logging\n","import librosa\n","from flask import Flask, request, jsonify\n","from transformers import (WhisperProcessor, WhisperForConditionalGeneration,\n","                          BlipProcessor, BlipForConditionalGeneration,\n","                          pipeline)\n","import threading\n","import uuid\n","\n","# Set up logging\n","logging.basicConfig(level=logging.INFO)\n","\n","# Load models\n","whisper_processor = WhisperProcessor.from_pretrained(\"openai/whisper-large\")\n","whisper_model = WhisperForConditionalGeneration.from_pretrained(\"openai/whisper-large\")\n","blip_processor = BlipProcessor.from_pretrained(\"Salesforce/blip-image-captioning-large\")\n","blip_model = BlipForConditionalGeneration.from_pretrained(\"Salesforce/blip-image-captioning-large\")\n","summarizer = pipeline(\"summarization\", model=\"facebook/bart-large-cnn\")\n","\n","# Device configuration\n","device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","whisper_model.to(device)\n","blip_model.to(device)\n","\n","# Flask app setup\n","app = Flask(__name__)\n","\n","# Job storage\n","jobs = {}\n","\n","# Function to download video from URL\n","def download_video(video_url, save_path='video.mp4'):\n","    logging.info(f\"Downloading video from {video_url}\")\n","    print(f\"Downloading video from {video_url}\")\n","    if video_url.startswith('http'):\n","        response = requests.get(video_url)\n","        with open(save_path, 'wb') as f:\n","            f.write(response.content)\n","    else:\n","        ydl_opts = {'format': 'best', 'outtmpl': save_path}\n","        with youtube_dl.YoutubeDL(ydl_opts) as ydl:\n","            ydl.download([video_url])\n","    print(f\"Video downloaded to {save_path}\")\n","    return save_path\n","\n","# Function to extract frames from the video\n","def extract_frames(video_path, num_frames=10):\n","    logging.info(f\"Extracting frames from {video_path}\")\n","    print(f\"Extracting frames from {video_path}\")\n","    cap = cv2.VideoCapture(video_path)\n","    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n","    frame_indices = np.linspace(0, total_frames - 1, num_frames, dtype=int)\n","\n","    frames = []\n","    for idx in frame_indices:\n","        cap.set(cv2.CAP_PROP_POS_FRAMES, idx)\n","        ret, frame = cap.read()\n","        if ret:\n","            frame = cv2.resize(frame, (224, 224))\n","            frames.append(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))\n","\n","    cap.release()\n","    print(f\"Extracted {len(frames)} frames\")\n","    return frames\n","\n","# Function to transcribe audio using Whisper\n","def transcribe_audio(audio_path):\n","    logging.info(\"Transcribing audio\")\n","    print(\"Transcribing audio\")\n","    audio, _ = librosa.load(audio_path, sr=16000)  # Ensure sampling rate is 16000\n","    inputs = whisper_processor(audio, return_tensors=\"pt\").input_features\n","    inputs = inputs.to(device)\n","\n","    with torch.no_grad():\n","        transcription = whisper_model.generate(inputs, max_length=500)\n","    transcription_text = whisper_processor.decode(transcription[0], skip_special_tokens=True)\n","    print(\"Audio transcription completed\")\n","    return transcription_text\n","\n","# Function to extract audio\n","def extract_audio(video_path, audio_path='audio.wav'):\n","    print(f\"Extracting audio from {video_path}\")\n","    command = [\"ffmpeg\", \"-i\", video_path, audio_path]  # Removed shell=True\n","\n","    result = subprocess.run(command, stderr=subprocess.PIPE, stdout=subprocess.PIPE)\n","    if result.returncode != 0:\n","        logging.error(f\"FFmpeg error: {result.stderr.decode()}\")\n","        raise Exception(\"Error extracting audio\")\n","    print(f\"Audio extracted to {audio_path}\")\n","\n","\n","# Function to generate captions for frames using BLIP\n","def caption_frames(frames):\n","    logging.info(\"Generating captions for frames\")\n","    print(\"Generating captions for frames\")\n","    captions = []\n","    for frame in frames:\n","        inputs = blip_processor(frame, return_tensors=\"pt\").to(device)\n","        outputs = blip_model.generate(**inputs)\n","        caption = blip_processor.decode(outputs[0], skip_special_tokens=True)\n","        captions.append(caption)\n","    print(f\"Generated {len(captions)} captions\")\n","    return captions\n","\n","# Function to summarize text using BART\n","def summarize_text(text):\n","    logging.info(\"Summarizing text\")\n","    print(\"Summarizing text\")\n","    summary = summarizer(text, max_length=150, min_length=50, do_sample=False)\n","    print(\"Text summarization completed\")\n","    return summary[0]['summary_text']\n","\n","# Function to generate video summary\n","def generate_video_summary(audio_summary, frame_captions):\n","    combined_text = f\"Audio Summary: {audio_summary}\\nVisual Descriptions:\\n\" + \"\\n\".join(frame_captions)\n","    final_summary = summarize_text(combined_text)\n","    print(\"Final video summary generated\")\n","    return final_summary\n","\n","# Function to process video (transcribing, captioning, summarizing)\n","def process_video(video_url, job_id):\n","    print(f\"Processing video for job ID: {job_id}\")\n","    try:\n","        video_path = download_video(video_url)\n","        audio_path = \"audio.wav\"\n","        extract_audio(video_path, audio_path)\n","        audio_summary = transcribe_audio(audio_path)\n","        frames = extract_frames(video_path)\n","        frame_captions = caption_frames(frames)\n","        final_summary = generate_video_summary(audio_summary, frame_captions)\n","\n","        # Store the result in jobs\n","        jobs[job_id]['status'] = 'completed'\n","        jobs[job_id]['summary'] = final_summary\n","    except Exception as e:\n","        logging.error(f\"Error processing video: {str(e)}\")\n","        jobs[job_id]['status'] = 'failed'\n","        jobs[job_id]['summary'] = \"Summary could not be generated due to an error.\"\n","        jobs[job_id]['error'] = str(e)\n","    finally:\n","        # Clean up temporary files\n","        if 'video_path' in locals() and os.path.exists(video_path):\n","            os.remove(video_path)\n","        if 'audio_path' in locals() and os.path.exists(audio_path):\n","            os.remove(audio_path)\n","\n","@app.route('/summarize', methods=['POST'])\n","def summarize():\n","    video_url = request.json.get('video_url')\n","\n","    job_id = str(uuid.uuid4())\n","\n","    # Initialize job status\n","    jobs[job_id] = {'status': 'processing', 'video_url': video_url}\n","\n","    # Start video processing in a new thread\n","    threading.Thread(target=process_video, args=(video_url, job_id)).start()\n","\n","    # Return job ID immediately\n","    return jsonify({'id': job_id}), 202\n","\n","@app.route('/status/<job_id>', methods=['GET'])\n","def get_status(job_id):\n","    job = jobs.get(job_id)\n","\n","    if job is None:\n","        return jsonify({'status': 'not found'}), 404\n","\n","    return jsonify({'status': job['status'], 'summary': job.get('summary'), 'error': job.get('error')}), 200\n"]},{"cell_type":"markdown","source":["# **mount drive**"],"metadata":{"id":"hwVY28IoWn8_"}},{"cell_type":"code","source":["from google.colab import drive\n","drive.mount('/content/drive')\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"nQWhFmR1WmY_","executionInfo":{"status":"ok","timestamp":173